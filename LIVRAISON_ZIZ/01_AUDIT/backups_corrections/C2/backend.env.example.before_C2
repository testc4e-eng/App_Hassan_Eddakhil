# Database connection
HDI_DB_NAME=hydro_hd
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hydro_hd
DB_USER=postgres
DB_PASSWORD=change_me_in_production
DB_SSL=false

# JWT
JWT_SECRET=change_me_to_a_random_secret_min_32_chars
JWT_EXPIRES_IN=8h

# Optional
BCRYPT_SALT_ROUNDS=12
PORT=5000
SWAT_MDB_PATH=
SWAT_DATA_ROOT=
SWAT_IMPORT_SCRIPT_PATH=
ENABLE_STARTUP_WARMUPS=true
ENABLE_STATION_MAPPING_INIT=true
STARTUP_WARMUP_DELAY_MS=250
STARTUP_WARMUP_TIMEOUT_MS=15000
SLOW_QUERY_LOG_MS=1000

# Seed users
SEED_USER_PASSWORD_HASH=$2b$12$...
SEED_ADMIN_EMAIL=admin@example.com
SEED_USER_EMAIL=user@example.com
