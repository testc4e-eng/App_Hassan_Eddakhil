# Application
# Main Docker delivery template for frontend -> backend -> db.
HDI_DB_NAME=hydro_hd

# Database
# POSTGRES_DB should stay aligned with HDI_DB_NAME unless a migration strategy says otherwise.
# Compatibility alias retained for scripts that still read POSTGRES_DB.
POSTGRES_DB=hydro_hd
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# In Docker delivery mode the backend reaches PostgreSQL through the Compose service name.
DB_HOST=db
DB_PORT=5432
DB_SSL=false

# Network
# PostgreSQL stays bound to localhost on the host for optional administration only.
DB_EXPOSE_PORT=5435
# Frontend is the only user-facing entry point in Docker delivery mode.
FRONTEND_EXPOSE_PORT=8089
# Leave empty when frontend and API are served from the same origin via Nginx.
# Set only when an external origin must reach the API with credentials.
CORS_ORIGIN=

# Security
JWT_SECRET=REPLACE_WITH_SECURE_VALUE_MIN_32_CHARS
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Optional runtime controls
ENABLE_STARTUP_WARMUPS=true
ENABLE_STATION_MAPPING_INIT=true
STARTUP_WARMUP_DELAY_MS=250
STARTUP_WARMUP_TIMEOUT_MS=15000
SLOW_QUERY_LOG_MS=1000

# Optional data paths
# Set HASSAN_DATA_ROOT when advanced spatial source data is provided outside the app bundle.
HASSAN_DATA_ROOT=
# Canonical PostgreSQL dump path kept for future restore work in LOT C4.
HYDRO_HD_DUMP_PATH=./hydro_hd.sql

# Optional seed users (used only when the seed script is executed manually)
SEED_USER_PASSWORD_HASH=
SEED_ADMIN_EMAIL=
SEED_USER_EMAIL=
