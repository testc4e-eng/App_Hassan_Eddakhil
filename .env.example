# PostgreSQL (used by docker-compose db service)
POSTGRES_DB=hydro_hd_1714
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# Host ports exposed by docker-compose
DB_EXPOSE_PORT=5435
BACKEND_EXPOSE_PORT=5006
FRONTEND_EXPOSE_PORT=8089

# Path to the PostgreSQL dump file used for automatic restore
HYDRO_HD_DUMP_PATH=./backups/hydro_hd.dump

# Backend secrets
JWT_SECRET=change_me_to_a_random_secret_min_32_chars
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:8089,http://127.0.0.1:8089

# Seed users (used by npm run seed:users)
SEED_USER_PASSWORD_HASH=$2b$12$...
SEED_ADMIN_EMAIL=c4e.africa@gmail.com
SEED_USER_EMAIL=ilhamqaidouh@gmail.com
