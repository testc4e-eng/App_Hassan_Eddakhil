# Backend local development template (outside Docker delivery mode)

# Database
HDI_DB_NAME=hydro_hd
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hydro_hd
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
DB_SSL=false

# Application
PORT=5000

# Security
JWT_SECRET=REPLACE_WITH_SECURE_VALUE_MIN_32_CHARS
JWT_EXPIRES_IN=8h

# Network
# Optional. Leave empty to use the built-in localhost allowances in development.
CORS_ORIGIN=

# Optional runtime controls
BCRYPT_SALT_ROUNDS=12
ENABLE_STARTUP_WARMUPS=true
ENABLE_STATION_MAPPING_INIT=true
STARTUP_WARMUP_DELAY_MS=250
STARTUP_WARMUP_TIMEOUT_MS=15000
SLOW_QUERY_LOG_MS=1000

# Optional data paths
# Set HASSAN_DATA_ROOT when local advanced spatial source data is stored outside the default project path.
HASSAN_DATA_ROOT=
# SWAT Windows/MDB integration is identified here but remains out of scope for LOT C5.
SWAT_MDB_PATH=
SWAT_DATA_ROOT=
SWAT_IMPORT_SCRIPT_PATH=

# Optional seed users
SEED_USER_PASSWORD_HASH=
SEED_ADMIN_EMAIL=
SEED_USER_EMAIL=
