{
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "check:encoding": "node ./scripts/check-utf8.mjs",
    "build": "npm run check:encoding && tsc",
    "type-check": "npm run check:encoding && tsc --noEmit",
    "lint": "eslint src server.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run type-check && npm run lint && npm run test:run && npm run build",
    "seed:users": "node scripts/seed-users.js",
    "auth:reset-password": "node scripts/reset-user-password.js",
    "siltation:audit": "ts-node-dev --transpile-only scripts/import_hassan_addakhil_siltation.ts --audit",
    "siltation:import": "ts-node-dev --transpile-only scripts/import_hassan_addakhil_siltation.ts",
    "bathy:audit": "ts-node-dev --transpile-only scripts/import_bathy_had.ts --audit",
    "bathy:import": "ts-node-dev --transpile-only scripts/import_bathy_had.ts --execute"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/node": "^25.2.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pdfkit": "^0.17.6",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.18.0",
    "wkt": "^0.1.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "overrides": {
    "express": {
      "path-to-regexp": "0.1.13"
    }
  }
}
